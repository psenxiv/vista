<Project>
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The build only reports unused usings (IDE0005) when it writes the XML docs. CS1591 and CS1573 would require documenting every member and parameter, and the file stays out of the plugin zip. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="Meziantou.Analyzer"
      Version="3.0.290"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers"
    />
  </ItemGroup>
</Project>
