{
  "title": "Vista in-game checks",
  "written": "2026-09-23",
  "revision": 4,
  "intro": [
    "A regression sweep over the code that changed and has no automated cover.",
    "Answers save in this browser as you go. Hit Download results at the end and send me the file."
  ],
  "sections": [
    {
      "id": "prep",
      "title": "Before you start",
      "groups": [
        {
          "id": "0",
          "title": "Setup",
          "steps": [
            {
              "t": "do",
              "id": "0.build",
              "text": "Run `make build`."
            },
            {
              "t": "do",
              "id": "0.reload",
              "text": "In game: `/xlplugins` -> Dev Tools -> Vista -> reload icon."
            },
            {
              "t": "do",
              "id": "0.open",
              "text": "Type `/vista`."
            },
            {
              "t": "note",
              "text": "Worth knowing: the mouse wheel steps fly speed whenever the cursor is not over a Vista window."
            }
          ]
        }
      ]
    },
    {
      "id": "s1",
      "title": "Section 1 - baseline capture",
      "blurb": "Cut. Kept only so the reasoning is on the record.",
      "groups": [
        {
          "id": "1.1",
          "title": "Common setup",
          "steps": [
            {
              "t": "do",
              "id": "1.1.mode",
              "text": "Mode dropdown (top row) -> Edit."
            },
            {
              "t": "do",
              "id": "1.1.speed",
              "text": "Fly speed, right of the feather icon, reads 1x."
            },
            {
              "t": "do",
              "id": "1.1.aim",
              "text": "Crosshair icon (second row, left) tooltips \"Select aim (Recorded aim)\". If not, click it and pick Recorded aim."
            },
            {
              "t": "do",
              "id": "1.1.fly",
              "text": "Fly somewhere open with a clear view of the ground."
            },
            {
              "t": "pick",
              "id": "1.1.ended",
              "label": "Mode you ended in",
              "options": [
                "Edit",
                "View",
                "Live",
                "Off"
              ]
            }
          ]
        },
        {
          "id": "1.2",
          "title": "Yaw ring",
          "need": "Which way Yaw moves for a given drag, and whether the glyph turns with the cursor or against it.",
          "feeds": "GizmoEditTests.TheYawRingChangesOnlyYaw, which asserted an absolute value and so passed either way. I derived +0.3.",
          "steps": [
            {
              "t": "do",
              "id": "1.2.add",
              "text": "Press Backtick to add a point."
            },
            {
              "t": "do",
              "id": "1.2.select",
              "text": "Single-click row 1 in the points table. A double-click flies the camera there instead."
            },
            {
              "t": "do",
              "id": "1.2.rotate",
              "text": "In the Point 1 window, click Rotate."
            },
            {
              "t": "note",
              "text": "Green ring is yaw — the flat one, parallel to the ground."
            },
            {
              "t": "num",
              "id": "1.2.before",
              "label": "Yaw before",
              "unit": "deg"
            },
            {
              "t": "do",
              "id": "1.2.drag",
              "text": "Drag the green ring a short way. Let go."
            },
            {
              "t": "text",
              "id": "1.2.direction",
              "label": "Which way you dragged",
              "placeholder": "e.g. left to right across the top"
            },
            {
              "t": "num",
              "id": "1.2.after",
              "label": "Yaw after",
              "unit": "deg"
            },
            {
              "t": "pick",
              "id": "1.2.glyph",
              "label": "The glyph turned",
              "options": [
                "with the cursor",
                "against it"
              ]
            }
          ]
        },
        {
          "id": "1.3",
          "title": "Pitch ring",
          "feeds": "GizmoEditTests.ThePitchRingChangesOnlyPitch. I derived +0.3.",
          "steps": [
            {
              "t": "note",
              "text": "Still Point 1, Rotate. Red ring is pitch — vertical, edge-on to the point's facing."
            },
            {
              "t": "num",
              "id": "1.3.before",
              "label": "Pitch before",
              "unit": "deg"
            },
            {
              "t": "do",
              "id": "1.3.drag",
              "text": "Drag the red ring a short way. Let go."
            },
            {
              "t": "text",
              "id": "1.3.direction",
              "label": "Which way you dragged",
              "placeholder": "in your own words"
            },
            {
              "t": "num",
              "id": "1.3.after",
              "label": "Pitch after",
              "unit": "deg"
            },
            {
              "t": "pick",
              "id": "1.3.glyph",
              "label": "The glyph tilted",
              "options": [
                "with the cursor",
                "against it"
              ]
            }
          ]
        },
        {
          "id": "1.4",
          "title": "Roll ring",
          "feeds": "GizmoEditTests.TheRollRingChangesOnlyRoll. I derived -0.3 — negative, because row 3 of PoseMatrix is back rather than forward. The one asymmetry worth seeing with your own eyes.",
          "steps": [
            {
              "t": "note",
              "text": "Still Point 1, Rotate. Blue ring is roll — face-on to the point's facing."
            },
            {
              "t": "num",
              "id": "1.4.before",
              "label": "Roll before",
              "unit": "deg"
            },
            {
              "t": "do",
              "id": "1.4.drag",
              "text": "Drag the blue ring a short way. Let go."
            },
            {
              "t": "text",
              "id": "1.4.direction",
              "label": "Which way you dragged",
              "placeholder": "in your own words"
            },
            {
              "t": "num",
              "id": "1.4.after",
              "label": "Roll after",
              "unit": "deg"
            },
            {
              "t": "pick",
              "id": "1.4.glyph",
              "label": "The glyph rolled",
              "options": [
                "with the cursor",
                "against it"
              ]
            }
          ]
        },
        {
          "id": "1.5",
          "title": "Pitch clamp",
          "need": "Each direction separately. The old test threw both into one array and never said which drag gave which.",
          "feeds": "ThePitchRingStopsAtThePitchLimit. Expect plus or minus 89.0; anything else is the finding.",
          "steps": [
            {
              "t": "do",
              "id": "1.5.up",
              "text": "Drag the red ring the way that makes Pitch go up, past where the number stops changing. Let go."
            },
            {
              "t": "num",
              "id": "1.5.highest",
              "label": "Highest Pitch",
              "unit": "deg"
            },
            {
              "t": "do",
              "id": "1.5.down",
              "text": "Drag it as far as it goes the other way. Let go."
            },
            {
              "t": "num",
              "id": "1.5.lowest",
              "label": "Lowest Pitch",
              "unit": "deg"
            },
            {
              "t": "pick",
              "id": "1.5.flip",
              "label": "Glyph flips or spins at either extreme?",
              "options": [
                "no",
                "yes"
              ]
            },
            {
              "t": "text",
              "id": "1.5.flipnote",
              "label": "If yes, what happened",
              "optional": true
            }
          ]
        },
        {
          "id": "1.6",
          "title": "Which world direction W/A/S/D move the camera",
          "need": "Position before and after a one-second press of each key, at a non-axis-aligned angle. Nothing in the UI reads out the camera's position, so a recorded point is the instrument.",
          "feeds": "Replaces two FreeCamMotionTests that were algebraic identities — they held even with degrees and radians swapped.",
          "steps": [
            {
              "t": "note",
              "text": "Don't move the mouse or scroll until the last row is filled. Signs and rough proportions are what I need; a one-second press isn't precise and I won't treat it as though it were."
            },
            {
              "t": "do",
              "id": "1.6.clear",
              "text": "Trash icon at the right of the second row (\"Clear track\"). Table empties."
            },
            {
              "t": "do",
              "id": "1.6.aim",
              "text": "Aim diagonally and slightly downward. Stop touching the mouse."
            },
            {
              "t": "do",
              "id": "1.6.p1",
              "text": "Backtick. Single-click row 1."
            },
            {
              "t": "row",
              "id": "1.6.start",
              "label": "Point 1 (start)",
              "cols": [
                "X",
                "Y",
                "Z",
                "Pitch",
                "Yaw",
                "Roll"
              ]
            },
            {
              "t": "note",
              "text": "If Pitch or Yaw reads exactly 0.0, go back and pick a less convenient angle."
            },
            {
              "t": "do",
              "id": "1.6.w",
              "text": "Hold W ~1s. Backtick. Select row 2."
            },
            {
              "t": "row",
              "id": "1.6.afterW",
              "label": "After W",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "do",
              "id": "1.6.s",
              "text": "Hold S ~1s. Backtick. Select row 3."
            },
            {
              "t": "row",
              "id": "1.6.afterS",
              "label": "After S",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "do",
              "id": "1.6.a",
              "text": "Hold A ~1s. Backtick. Select row 4."
            },
            {
              "t": "row",
              "id": "1.6.afterA",
              "label": "After A",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "do",
              "id": "1.6.d",
              "text": "Hold D ~1s. Backtick. Select row 5."
            },
            {
              "t": "row",
              "id": "1.6.afterD",
              "label": "After D",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "do",
              "id": "1.6.space",
              "text": "Hold Space ~1s. Backtick. Select row 6."
            },
            {
              "t": "row",
              "id": "1.6.afterSpace",
              "label": "After Space",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "do",
              "id": "1.6.c",
              "text": "Hold C ~1s. Backtick. Select row 7."
            },
            {
              "t": "row",
              "id": "1.6.afterC",
              "label": "After C",
              "cols": [
                "X",
                "Y",
                "Z"
              ]
            },
            {
              "t": "note",
              "text": "Mouse is free again."
            }
          ]
        },
        {
          "id": "1.6b",
          "title": "Optional: the same at yaw 0",
          "optional": true,
          "need": "At yaw 0 the answer is derivable by hand with no trigonometry, so it is the cleanest check on my derivation. Skip the group if holding the angle is fiddly.",
          "steps": [
            {
              "t": "do",
              "id": "1.6b.setup",
              "text": "Clear the track. Face due north (Yaw near 0.0) and level (Pitch near 0.0). Repeat the W/S/A/D captures.",
              "optional": true
            },
            {
              "t": "row",
              "id": "1.6b.start",
              "label": "Start",
              "cols": [
                "X",
                "Y",
                "Z",
                "Yaw"
              ],
              "optional": true
            },
            {
              "t": "row",
              "id": "1.6b.afterW",
              "label": "After W",
              "cols": [
                "X",
                "Y",
                "Z",
                "Yaw"
              ],
              "optional": true
            },
            {
              "t": "row",
              "id": "1.6b.afterS",
              "label": "After S",
              "cols": [
                "X",
                "Y",
                "Z",
                "Yaw"
              ],
              "optional": true
            },
            {
              "t": "row",
              "id": "1.6b.afterA",
              "label": "After A",
              "cols": [
                "X",
                "Y",
                "Z",
                "Yaw"
              ],
              "optional": true
            },
            {
              "t": "row",
              "id": "1.6b.afterD",
              "label": "After D",
              "cols": [
                "X",
                "Y",
                "Z",
                "Yaw"
              ],
              "optional": true
            }
          ]
        },
        {
          "id": "1.7",
          "title": "Where the camera looks after a strafe",
          "need": "Whether strafing changes the aim, and which way the world slides.",
          "feeds": "Nothing in the repo pinned the slide — negate the strafe axis and every old assertion still passed, so A and D swapped would have shipped green.",
          "steps": [
            {
              "t": "do",
              "id": "1.7.aim",
              "text": "Aim diagonally and downward. Stop touching the mouse. Backtick, select the last row."
            },
            {
              "t": "row",
              "id": "1.7.before",
              "label": "Before",
              "cols": [
                "Pitch",
                "Yaw",
                "Roll"
              ]
            },
            {
              "t": "do",
              "id": "1.7.d",
              "text": "Hold D ~1s. Backtick, select the new last row."
            },
            {
              "t": "row",
              "id": "1.7.afterD",
              "label": "After D",
              "cols": [
                "Pitch",
                "Yaw",
                "Roll"
              ]
            },
            {
              "t": "pick",
              "id": "1.7.slideD",
              "label": "Holding D, the world slid",
              "options": [
                "left",
                "right"
              ]
            },
            {
              "t": "do",
              "id": "1.7.a",
              "text": "Hold A ~1s. Backtick, select the new last row."
            },
            {
              "t": "row",
              "id": "1.7.afterA",
              "label": "After A",
              "cols": [
                "Pitch",
                "Yaw",
                "Roll"
              ]
            },
            {
              "t": "pick",
              "id": "1.7.slideA",
              "label": "Holding A, the world slid",
              "options": [
                "left",
                "right"
              ]
            }
          ]
        },
        {
          "id": "1.8",
          "title": "Tidy up",
          "steps": [
            {
              "t": "do",
              "id": "1.8.off",
              "text": "Mode dropdown -> Off."
            }
          ]
        }
      ],
      "skip": "every sign here is already pinned by hand-derived assertions in GizmoEditTests and FreeCamMotionTests; items 12 and 13 changed no source, so nothing can have regressed"
    },
    {
      "id": "s2",
      "title": "Section 2 - regression checks",
      "blurb": "Mark Pass, Fail or N/A. A note only matters on a Fail or something odd.",
      "groups": [
        {
          "id": "2.1",
          "title": "Live mode (item 14)",
          "need": "IsLive went from a settable field to a property derived from the current shot. The risk is a camera that silently stops moving, so every row asks whether it actually responds.",
          "steps": [
            {
              "t": "do",
              "id": "2.1.s1",
              "text": "Mode -> Edit. Trash icon to clear the track."
            },
            {
              "t": "do",
              "id": "2.1.s2",
              "text": "Backtick, fly a noticeable distance, Backtick, again — three points."
            },
            {
              "t": "do",
              "id": "2.1.s3",
              "text": "Playlist panel: plus icon -> Track 1. One row appears."
            },
            {
              "t": "check",
              "id": "2.1.1",
              "action": "Mode -> Live",
              "expect": "Camera jumps to the first point and holds. LIVE pulses in the top row."
            },
            {
              "t": "check",
              "id": "2.1.2",
              "action": "Click Play, left of the scrub bar",
              "expect": "Camera moves. Scrub bar advances."
            },
            {
              "t": "check",
              "id": "2.1.3",
              "action": "Click again (Pause)",
              "expect": "Camera and scrub bar stop."
            },
            {
              "t": "check",
              "id": "2.1.4",
              "action": "Click again (Play)",
              "expect": "Resumes where it stopped, not from the start."
            },
            {
              "t": "check",
              "id": "2.1.5",
              "action": "While playing, drag the scrub bar to halfway",
              "expect": "Camera follows the drag."
            },
            {
              "t": "check",
              "id": "2.1.6",
              "action": "Release",
              "expect": "Playback carries on from there."
            },
            {
              "t": "check",
              "id": "2.1.7",
              "action": "Pause, drag the scrub bar",
              "expect": "Camera follows the drag."
            },
            {
              "t": "check",
              "id": "2.1.8",
              "action": "Release",
              "expect": "Stays paused. Does not start playing."
            },
            {
              "t": "check",
              "id": "2.1.9",
              "action": "Click Restart, the step-backward icon",
              "expect": "Jumps to the first point and plays."
            },
            {
              "t": "check",
              "id": "2.1.10",
              "action": "Let it run to the end",
              "expect": "Holds the last frame. No jump or mid-track freeze."
            },
            {
              "t": "check",
              "id": "2.1.11",
              "action": "Click Play at the end",
              "expect": "Starts again from the beginning."
            },
            {
              "t": "check",
              "id": "2.1.12",
              "action": "Mode -> Off",
              "expect": "Game camera returns to the character, where it was before Vista took it."
            },
            {
              "t": "check",
              "id": "2.1.13",
              "action": "Mode -> Live, click Play",
              "expect": "Plays as in row 2."
            },
            {
              "t": "check",
              "id": "2.1.14",
              "action": "While playing, toggle the eye-slash icon",
              "expect": "Game UI hides."
            },
            {
              "t": "check",
              "id": "2.1.15",
              "action": "Press Escape",
              "expect": "UI returns. System menu does not open."
            }
          ]
        },
        {
          "id": "2.2",
          "title": "Editor surface",
          "need": "Written as a 50-row sweep for item 16, which I didn't enact. Only the rows covering code that changed are shown; the toggle up top reveals the rest.",
          "steps": [
            {
              "t": "do",
              "id": "2.2.s1",
              "text": "Mode -> Edit, track cleared, three points added as in 2.1."
            },
            {
              "t": "check",
              "id": "2.2.1",
              "action": "Sitemap icon, top row",
              "expect": "Hierarchy panel hides.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.2",
              "action": "Click it again",
              "expect": "Hierarchy returns.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.3",
              "action": "List icon, top row",
              "expect": "Playlist panel hides.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.4",
              "action": "Click it again",
              "expect": "Playlist returns.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.5",
              "action": "Hierarchy: plus icon",
              "expect": "Track 2 appears and becomes the edited one.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.6",
              "action": "Click Track 1's row",
              "expect": "Track 1 is edited again; its points reappear.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.7",
              "action": "Right-click Track 1 -> Rename, type, Enter",
              "expect": "The name changes.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.8",
              "action": "Right-click -> Duplicate",
              "expect": "A \"… copy\" appears below and becomes edited.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.9",
              "action": "Right-click the copy -> Delete",
              "expect": "It disappears.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.10",
              "action": "Drag Track 2 above Track 1",
              "expect": "The order changes.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.11",
              "action": "Track 2's eye icon",
              "expect": "Track 2 greys out in the world.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.12",
              "action": "Click it again",
              "expect": "Draws normally.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.13",
              "action": "Single-click row 2",
              "expect": "Point 2 highlights; its window opens.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.14",
              "action": "Double-click row 2",
              "expect": "Camera flies to point 2.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.15",
              "action": "Drag the X field in the Point 2 window",
              "expect": "The point slides along X as you drag.",
              "why": "item 20"
            },
            {
              "t": "check",
              "id": "2.2.16",
              "action": "Ctrl + Z",
              "expect": "Undone in one step.",
              "why": "item 20"
            },
            {
              "t": "check",
              "id": "2.2.17",
              "action": "Ctrl + Y",
              "expect": "Redone.",
              "why": "item 20"
            },
            {
              "t": "check",
              "id": "2.2.18",
              "action": "Press R",
              "expect": "Gizmo switches Move/Rotate; radio buttons follow.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.19",
              "action": "Copy icon, then paste icon",
              "expect": "Values unchanged, no error.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.20",
              "action": "Press Delete",
              "expect": "Point 2 leaves the table.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.21",
              "action": "Ctrl + Z",
              "expect": "It comes back.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.22",
              "action": "Press Backtick",
              "expect": "A point is appended at the camera.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.23",
              "action": "Select a point, Alt + Backtick",
              "expect": "A point is inserted after it and selected.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.24",
              "action": "Select a point, Ctrl + Backtick",
              "expect": "It moves to the camera.",
              "skip": "item 16 not enacted"
            },
            {
              "t": "check",
              "id": "2.2.25",
              "action": "Caret beside the plus, second row",
              "expect": "Add menu opens: three entries with shortcuts.",
              "skip": "item 16 not enacted"
            },
