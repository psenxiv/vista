<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.1.1</Version>
    <AssemblyName>Vista</AssemblyName>
    <RootNamespace>Vista.Plugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Guide\*.md" LogicalName="Vista.Guide.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Without SetPlatform, x64 propagates to Core and design-time builds look in a bin/x64 no build writes. -->
    <ProjectReference Include="../Vista.Core/Vista.Core.csproj" SetPlatform="Platform=AnyCPU" />
  </ItemGroup>
</Project>
